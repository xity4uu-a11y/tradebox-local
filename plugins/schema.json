{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xity4uu-a11y/tradebox-local/plugins/schema.json",
  "title": "TradeBox Local Community Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "category",
    "author",
    "description",
    "min_tradebox_version",
    "enabled_by_default",
    "tags",
    "triggers",
    "config",
    "rules"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string",
      "enum": ["latency", "journal", "alerts", "host", "container"]
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 12,
      "maxLength": 320
    },
    "min_tradebox_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "enabled_by_default": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "config": {
      "type": "object"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "severity", "action"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "match": {
            "type": "string",
            "minLength": 2
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warn", "critical"]
          },
          "action": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  }
}
